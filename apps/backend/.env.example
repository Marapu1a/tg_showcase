HOST=0.0.0.0
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tg_showcase
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
BACKEND_PUBLIC_URL=https://backend.example.com
