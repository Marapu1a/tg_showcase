generator client {
  provider = "prisma-client-js"
}

model HubProject {
  id String @id @default(cuid())
  slug String @unique
  name String
  summary String
  description String
  telegramUrl String
  status String @default("ACTIVE")
  visible Boolean @default(false)
  version Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OwnerAudit {
  id String @id @default(cuid())
  telegramUserId String
  action String
  projectId String
  details Json
  createdAt DateTime @default(now())
  @@index([createdAt])
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProductStatus {
  ACTIVE
  HIDDEN
  ARCHIVED
}

enum OfferStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum OfferEventType {
  BUY_CLICK
  DETAIL_CLICK
}

enum OrderStatus {
  NEW
  IN_PROGRESS
  DONE
  CANCELLED
  RETURNED
}

model User {
  id             String  @id @default(cuid())
  telegramUserId String  @unique
  username       String?
  firstName      String?
  lastName       String?
  buyerContactUsername String?

  products Product[]
  offers   Offer[]
  channel  SellerChannel?
  orders OrderRequest[]
  media Media[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
}

model SellerChannel {
  ownerUserId String @id
  channelId String @unique
  title String
  username String?
  verifiedAt DateTime @default(now())
  ownerUser User @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
}

model Product {
  id            String        @id @default(cuid())
  ownerUserId   String
  title         String
  description   String?
  priceText     String
  checkoutUrl   String?
  priceMinor Int?
  currency String @default("RUB")
  reservedQuantity Int @default(0)
  status        ProductStatus @default(ACTIVE)
  quantityLimit Int?

  ownerUser   User           @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  images      ProductImage[]
  offers      Offer[]
  offerEvents OfferEvent[]
  orders OrderRequest[]
  stockAdditions StockAddition[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerUserId])
  @@index([status])
  @@index([createdAt])
}

model ProductImage {
  id        String @id @default(cuid())
  productId String
  fileUrl   String
  sortOrder Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([productId])
  @@index([sortOrder])
}

model Offer {
  id          String @id @default(cuid())
  productId   String
  ownerUserId String

  title  String
  text   String?
  status OfferStatus @default(DRAFT)

  channelId         String?
  telegramMessageId String?
  publishedAt       DateTime?
  creationKey String? @unique
  creationFingerprint String?
  publishState String @default("IDLE")

  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  ownerUser User         @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  events    OfferEvent[]
  billing PublicationBill?
  starInvoices StarInvoice[]
  starPayments StarPayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([ownerUserId])
  @@index([status])
  @@index([publishedAt])
  @@index([ownerUserId, createdAt, id])
}

model Media {
  id String @id @default(cuid())
  ownerUserId String
  data Bytes
  createdAt DateTime @default(now())
  ownerUser User @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  @@index([ownerUserId])
}

model OrderRequest {
  id String @id @default(cuid())
  number Int @unique @default(autoincrement())
  ownerUserId String
  productId String
  offerId String
  requestKey String @unique
  requestFingerprint String
  productTitle String
  unitPriceMinor Int
  totalMinor Int
  currency String @default("RUB")
  quantity Int
  buyerName String?
  buyerTelegramUserId String?
  contact String
  contactSearch String @default("")
  contactType String
  contactVerified Boolean @default(false)
  comment String?
  status OrderStatus @default(NEW)
  version Int @default(0)
  stockReleased Boolean @default(false)
  history OrderHistory[]
  notificationState String @default("PENDING")
  notificationAttempts Int @default(0)
  notificationNextAt DateTime @default(now())
  notificationSentAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ownerUser User @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([ownerUserId, status, createdAt])
  @@index([notificationState, notificationNextAt])
  @@index([offerId, createdAt])
  @@index([ownerUserId, number])
}

model OrderHistory {
  id String @id @default(cuid())
  orderId String
  actorUserId String
  fromStatus OrderStatus
  toStatus OrderStatus
  reason String?
  stockDelta Int @default(0)
  requestKey String @unique
  fingerprint String
  createdAt DateTime @default(now())
  order OrderRequest @relation(fields: [orderId], references: [id], onDelete: Restrict)
  @@index([orderId, createdAt, id])
}

model OfferEvent {
  id                   String         @id @default(cuid())
  offerId              String
  productId            String
  type                 OfferEventType
  viewerTelegramUserId String?

  offer   Offer   @relation(fields: [offerId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([offerId])
  @@index([productId])
  @@index([type])
  @@index([createdAt])
  @@index([viewerTelegramUserId])
}

model StockAddition {
  id String @id @default(cuid())
  productId String
  ownerUserId String
  quantity Int
  note String?
  requestKey String @unique
  createdAt DateTime @default(now())
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  @@index([productId, createdAt])
}

model PublicationBill {
  offerId String @id
  ownerUserId String
  kind String
  state String
  paymentId String? @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  offer Offer @relation(fields: [offerId], references: [id], onDelete: Restrict)
  @@index([ownerUserId, kind, state])
}
model StarInvoice {
  id String @id @default(cuid())
  offerId String
  ownerUserId String
  telegramUserId String
  stars Int
  state String @default("OPEN")
  precheckoutId String?
  termsVersion String @default("stars-v1")
  createdAt DateTime @default(now())
  expiresAt DateTime
  offer Offer @relation(fields: [offerId], references: [id], onDelete: Restrict)
  @@index([offerId, state])
}
model StarPayment {
  chargeId String @id
  invoiceId String
  offerId String
  ownerUserId String
  telegramUserId String
  stars Int
  state String
  reason String?
  createdAt DateTime @default(now())
  refundNextAt DateTime @default(now())
  refundAttempts Int @default(0)
  offer Offer @relation(fields: [offerId], references: [id], onDelete: Restrict)
  @@index([state, refundNextAt])
  @@index([ownerUserId, createdAt])
}
