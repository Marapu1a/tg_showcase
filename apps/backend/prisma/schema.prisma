generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProductStatus {
  ACTIVE
  HIDDEN
  ARCHIVED
}

enum OfferStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum OfferEventType {
  BUY_CLICK
  DETAIL_CLICK
}

enum OrderStatus {
  NEW
  IN_PROGRESS
  DONE
  CANCELLED
}

model User {
  id             String  @id @default(cuid())
  telegramUserId String  @unique
  username       String?
  firstName      String?
  lastName       String?

  products Product[]
  offers   Offer[]
  channel  SellerChannel?
  orders OrderRequest[]
  media Media[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
}

model SellerChannel {
  ownerUserId String @id
  channelId String @unique
  title String
  username String?
  verifiedAt DateTime @default(now())
  ownerUser User @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
}

model Product {
  id            String        @id @default(cuid())
  ownerUserId   String
  title         String
  description   String?
  priceText     String
  checkoutUrl   String?
  priceMinor Int?
  reservedQuantity Int @default(0)
  status        ProductStatus @default(ACTIVE)
  quantityLimit Int?

  ownerUser   User           @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  images      ProductImage[]
  offers      Offer[]
  offerEvents OfferEvent[]
  orders OrderRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerUserId])
  @@index([status])
  @@index([createdAt])
}

model ProductImage {
  id        String @id @default(cuid())
  productId String
  fileUrl   String
  sortOrder Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([productId])
  @@index([sortOrder])
}

model Offer {
  id          String @id @default(cuid())
  productId   String
  ownerUserId String

  title  String
  text   String?
  status OfferStatus @default(DRAFT)

  channelId         String?
  telegramMessageId String?
  publishedAt       DateTime?
  creationKey String? @unique
  creationFingerprint String?
  publishState String @default("IDLE")

  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  ownerUser User         @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  events    OfferEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([ownerUserId])
  @@index([status])
  @@index([publishedAt])
}

model Media {
  id String @id @default(cuid())
  ownerUserId String
  data Bytes
  createdAt DateTime @default(now())
  ownerUser User @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  @@index([ownerUserId])
}

model OrderRequest {
  id String @id @default(cuid())
  number Int @unique @default(autoincrement())
  ownerUserId String
  productId String
  offerId String
  requestKey String @unique
  requestFingerprint String
  productTitle String
  unitPriceMinor Int
  totalMinor Int
  currency String @default("RUB")
  quantity Int
  buyerName String?
  buyerTelegramUserId String?
  contact String
  contactType String
  contactVerified Boolean @default(false)
  comment String?
  status OrderStatus @default(NEW)
  notificationState String @default("PENDING")
  notificationAttempts Int @default(0)
  notificationNextAt DateTime @default(now())
  notificationSentAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ownerUser User @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([ownerUserId, status, createdAt])
  @@index([notificationState, notificationNextAt])
  @@index([offerId, createdAt])
}

model OfferEvent {
  id                   String         @id @default(cuid())
  offerId              String
  productId            String
  type                 OfferEventType
  viewerTelegramUserId String?

  offer   Offer   @relation(fields: [offerId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([offerId])
  @@index([productId])
  @@index([type])
  @@index([createdAt])
  @@index([viewerTelegramUserId])
}
